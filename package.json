{
  "name": "futuristic",
  "private": true,
  "description": "Futuristic builds portable digital identity infrastructure for vehicles, autonomous systems, and the connected world.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "turbo run dev",
    "build": "pnpm db:generate && turbo run build",
    "vercel-build": "pnpm db:generate && turbo run build --filter=@futuristic/api...",
    "db:generate": "pnpm --filter @futuristic/db run generate",
    "db:migrate": "pnpm --filter @futuristic/db run migrate",
    "db:seed": "pnpm --filter @futuristic/db run seed",
    "db:push": "pnpm --filter @futuristic/db run push",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@9.15.0"
}
